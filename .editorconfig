root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Markdown uses a trailing double-space for a hard line break; trimming it silently
# breaks that convention.
[*.md]
trim_trailing_whitespace = false

[*.py]
indent_size = 4

[*.{ps1,psm1}]
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

[*.{cs,razor}]
indent_size = 4
